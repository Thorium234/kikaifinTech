<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="http://wixtoolset.org/schemas/thmutil/2010">
  <!-- Window definition -->
  <Window
    Width="620"
    Height="480"
    HexStyle="14000000"
    FontId="0"
    HideMaximizeButton="yes"
    HideMinimizeButton="no">
    <WindowTitle>ThorCash Financial System - Installer</WindowTitle>
  </Window>

  <!-- Font Definitions -->
  <Font Id="0" Height="-13" Weight="400" Foreground="1A1A1A" Background="FFFFFF">Segoe UI</Font>
  <Font Id="1" Height="-24" Weight="300" Foreground="0D1B2A" Background="FFFFFF">Segoe UI Light</Font>
  <Font Id="2" Height="-16" Weight="600" Foreground="0D1B2A" Background="FFFFFF">Segoe UI</Font>
  <Font Id="3" Height="-11" Weight="400" Foreground="666666" Background="FFFFFF">Segoe UI</Font>
  <Font Id="4" Height="-24" Weight="300" Foreground="FFFFFF" Background="0A6633">Segoe UI Light</Font>
  <Font Id="5" Height="-13" Weight="400" Foreground="FFFFFF" Background="0A6633">Segoe UI</Font>
  <Font Id="6" Height="-13" Weight="400" Foreground="0A6633" Background="FFFFFF">Segoe UI</Font>
  <Font Id="7" Height="-32" Weight="300" Foreground="0D1B2A" Background="FFFFFF">Segoe UI Light</Font>
  <Font Id="8" Height="-11" Weight="400" Foreground="999999" Background="FFFFFF">Segoe UI</Font>
  <Font Id="9" Height="-13" Weight="400" Foreground="FFFFFF" Background="0A6633">Segoe UI</Font>

  <!-- Page: Welcome / Install -->
  <Page Name="Install">
    <!-- Background fill -->
    <Rectangle X="0" Y="0" Width="620" Height="480" Fill="FFFFFF" />

    <!-- Left sidebar branding -->
    <Rectangle X="0" Y="0" Width="200" Height="480" Fill="0D1B2A" />

    <!-- Product name vertical -->
    <Text X="20" Y="100" Width="160" Height="60" FontId="4" DisablePrefix="yes">ThorCash</Text>
    <Text X="20" Y="155" Width="160" Height="40" FontId="5" DisablePrefix="yes">Financial System</Text>

    <!-- Decorative line -->
    <Rectangle X="20" Y="195" Width="60" Height="3" Fill="0A6633" />

    <!-- Version -->
    <Text X="20" Y="210" Width="160" Height="20" FontId="9" DisablePrefix="yes" HideWhenDisabled="yes">Version 1.0.0</Text>

    <!-- Footer branding -->
    <Text X="20" Y="420" Width="160" Height="40" FontId="8" DisablePrefix="yes">Thor Technologies</Text>

    <!-- Right side content -->
    <!-- Title -->
    <Text X="230" Y="40" Width="360" Height="50" FontId="7" DisablePrefix="yes">Welcome to ThorCash</Text>
    <Text X="230" Y="85" Width="360" Height="20" FontId="3" DisablePrefix="yes">Financial Management System</Text>

    <!-- Separator line -->
    <Rectangle X="230" Y="115" Width="360" Height="1" Fill="E0E0E0" />

    <!-- Description -->
    <Text X="230" Y="135" Width="360" Height="60" FontId="0" DisablePrefix="yes">This wizard will guide you through installing ThorCash Financial System on your computer. The application includes a bundled Java runtime and all necessary dependencies.</Text>

    <!-- License area -->
    <Text X="230" Y="200" Width="360" Height="20" FontId="2" DisablePrefix="yes">License Agreement</Text>
    <ScrollableText
      X="230"
      Y="220"
      Width="360"
      Height="120"
      FontId="0"
      TabStop="yes"
      HexBackground="F8F9FA"
      HexBorder="DEE2E6" />

    <!-- License acceptance checkbox -->
    <Checkbox
      Name="AcceptLicense"
      X="230"
      Y="350"
      Width="360"
      Height="25"
      FontId="0"
      TabStop="yes"
      HideWhenDisabled="yes">
      I &amp;accept the terms of the License Agreement
    </Checkbox>

    <!-- Buttons -->
    <Button
      Name="InstallButton"
      X="430"
      Y="420"
      Width="160"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="0A6633"
      HexForeground="FFFFFF"
      HexBorder="0A6633"
      DisabledHexBackground="CCCCCC"
      DisabledHexForeground="FFFFFF"
      DisabledHexBorder="CCCCCC"
      HexHighlightBackground="0D803F"
      HexHighlightForeground="FFFFFF"
      HexHighlightBorder="0D803F">
      Install
    </Button>
    <Button
      Name="OptionsButton"
      X="260"
      Y="420"
      Width="160"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      DisabledHexBackground="F5F5F5"
      DisabledHexForeground="CCCCCC"
      DisabledHexBorder="E0E0E0"
      HexHighlightBackground="F0F0F0"
      HexHighlightForeground="1A1A1A"
      HexHighlightBorder="0A6633">
      Options
    </Button>
    <Button
      Name="CancelButton"
      X="100"
      Y="420"
      Width="150"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      HexHighlightBackground="F8D7DA"
      HexHighlightForeground="721C24"
      HexHighlightBorder="F5C6CB">
      Cancel
    </Button>
  </Page>

  <!-- Page: Options (Installation Folder) -->
  <Page Name="Options">
    <!-- Background -->
    <Rectangle X="0" Y="0" Width="620" Height="480" Fill="FFFFFF" />

    <!-- Left sidebar branding -->
    <Rectangle X="0" Y="0" Width="200" Height="480" Fill="0D1B2A" />
    <Text X="20" Y="100" Width="160" Height="60" FontId="4" DisablePrefix="yes">ThorCash</Text>
    <Text X="20" Y="155" Width="160" Height="40" FontId="5" DisablePrefix="yes">Financial System</Text>
    <Rectangle X="20" Y="195" Width="60" Height="3" Fill="0A6633" />

    <!-- Right side - Installation folder -->
    <Text X="230" Y="40" Width="360" Height="50" FontId="7" DisablePrefix="yes">Installation Options</Text>
    <Text X="230" Y="85" Width="360" Height="20" FontId="3" DisablePrefix="yes">Choose where to install ThorCash</Text>
    <Rectangle X="230" Y="115" Width="360" Height="1" Fill="E0E0E0" />

    <Text X="230" Y="135" Width="360" Height="20" FontId="2" DisablePrefix="yes">Installation Folder</Text>
    <Text X="230" Y="158" Width="360" Height="15" FontId="3" DisablePrefix="yes">Select the folder where ThorCash will be installed:</Text>

    <TextBox
      Name="Folder"
      X="230"
      Y="180"
      Width="300"
      Height="25"
      FontId="0"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      TabStop="yes"
      FilePath="yes"
      DisabledHexBackground="F5F5F5"
      DisabledHexForeground="999999"
      DisabledHexBorder="E0E0E0" />

    <Button
      Name="Browse"
      X="540"
      Y="180"
      Width="50"
      Height="25"
      FontId="0"
      TabStop="yes"
      HexBackground="F8F9FA"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      HexHighlightBackground="E9ECEF"
      HexHighlightForeground="1A1A1A"
      HexHighlightBorder="0A6633">
      ...
    </Button>

    <!-- Disk space information -->
    <Text X="230" Y="220" Width="360" Height="15" FontId="8" DisablePrefix="yes">Required disk space: ~250 MB</Text>
    <Text X="230" Y="238" Width="360" Height="15" FontId="8" DisablePrefix="yes">Available disk space on C:\: ~100 GB</Text>

    <!-- HyperlinkSidebar page includes options -->
    <Checkbox
      Name="LaunchOnStartup"
      X="230"
      Y="275"
      Width="360"
      Height="20"
      FontId="0"
      TabStop="yes"
      HideWhenDisabled="yes">
      Launch ThorCash on &amp;startup (optional)
    </Checkbox>

    <!-- Buttons -->
    <Button
      Name="InstallButton"
      X="430"
      Y="420"
      Width="160"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="0A6633"
      HexForeground="FFFFFF"
      HexBorder="0A6633"
      DisabledHexBackground="CCCCCC"
      DisabledHexForeground="FFFFFF"
      DisabledHexBorder="CCCCCC"
      HexHighlightBackground="0D803F"
      HexHighlightForeground="FFFFFF"
      HexHighlightBorder="0D803F">
      Install
    </Button>
    <Button
      Name="BackButton"
      X="100"
      Y="420"
      Width="150"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      HexHighlightBackground="F0F0F0"
      HexHighlightForeground="1A1A1A"
      HexHighlightBorder="0A6633">
      Back
    </Button>
    <Button
      Name="CancelButton"
      X="20"
      Y="420"
      Width="70"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      HexHighlightBackground="F8D7DA"
      HexHighlightForeground="721C24"
      HexHighlightBorder="F5C6CB">
      Cancel
    </Button>
  </Page>

  <!-- Page: Progress -->
  <Page Name="Progress">
    <!-- Background -->
    <Rectangle X="0" Y="0" Width="620" Height="480" Fill="FFFFFF" />

    <!-- Left sidebar branding -->
    <Rectangle X="0" Y="0" Width="200" Height="480" Fill="0D1B2A" />
    <Text X="20" Y="100" Width="160" Height="60" FontId="4" DisablePrefix="yes">ThorCash</Text>
    <Text X="20" Y="155" Width="160" Height="40" FontId="5" DisablePrefix="yes">Financial System</Text>
    <Rectangle X="20" Y="195" Width="60" Height="3" Fill="0A6633" />

    <!-- Installation progress -->
    <Text X="230" Y="40" Width="360" Height="50" FontId="7" DisablePrefix="yes">Installing ThorCash</Text>
    <Rectangle X="230" Y="85" Width="360" Height="1" Fill="E0E0E0" />

    <!-- Overall progress -->
    <Text X="230" Y="110" Width="360" Height="20" FontId="2" DisablePrefix="yes">Overall Progress</Text>
    <Progressbar
      Name="OverallProgress"
      X="230"
      Y="135"
      Width="360"
      Height="25"
      TabStop="no"
      HexBackground="E9ECEF"
      HexForeground="0A6633"
      HexBorder="DEE2E6" />

    <!-- Current action -->
    <Text X="230" Y="175" Width="360" Height="20" FontId="3" DisablePrefix="yes">Current Action</Text>
    <Text
      Name="OverallProgressText"
      X="230"
      Y="195"
      Width="360"
      Height="40"
      FontId="0"
      DisablePrefix="yes"
      HideWhenDisabled="yes">Preparing installation...</Text>

    <!-- Files being copied -->
    <Text X="230" Y="245" Width="360" Height="20" FontId="3" DisablePrefix="yes">Files</Text>
    <Text
      Name="CurrentFileText"
      X="230"
      Y="265"
      Width="360"
      Height="60"
      FontId="0"
      DisablePrefix="yes"
      HideWhenDisabled="yes">Copying files...</Text>

    <!-- Estimated remaining time -->
    <Text
      Name="TimeRemainingText"
      X="230"
      Y="340"
      Width="360"
      Height="20"
      FontId="8"
      DisablePrefix="yes"
      HideWhenDisabled="yes">Estimated remaining time: Calculating...</Text>

    <!-- Cancel button -->
    <Button
      Name="CancelButton"
      X="430"
      Y="420"
      Width="160"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      HexHighlightBackground="F8D7DA"
      HexHighlightForeground="721C24"
      HexHighlightBorder="F5C6CB">
      Cancel
    </Button>
  </Page>

  <!-- Page: Finish -->
  <Page Name="Finish">
    <!-- Background -->
    <Rectangle X="0" Y="0" Width="620" Height="480" Fill="FFFFFF" />

    <!-- Left sidebar branding - success accent -->
    <Rectangle X="0" Y="0" Width="200" Height="480" Fill="0A6633" />
    <Text X="20" Y="100" Width="160" Height="60" FontId="4" DisablePrefix="yes">ThorCash</Text>
    <Text X="20" Y="155" Width="160" Height="40" FontId="5" DisablePrefix="yes">Financial System</Text>
    <Rectangle X="20" Y="195" Width="60" Height="3" Fill="FFFFFF" />

    <!-- Checkmark indicator area -->
    <Text X="60" Y="280" Width="80" Height="80" FontId="4" DisablePrefix="yes">✓</Text>

    <!-- Completion content -->
    <Text X="230" Y="40" Width="360" Height="50" FontId="7" DisablePrefix="yes">Installation Complete</Text>
    <Rectangle X="230" Y="85" Width="360" Height="1" Fill="E0E0E0" />

    <Text X="230" Y="110" Width="360" Height="60" FontId="0" DisablePrefix="yes">ThorCash Financial System has been successfully installed on your computer. You can now launch the application from the Start Menu or desktop shortcut.</Text>

    <!-- Launch checkbox -->
    <Checkbox
      Name="LaunchApplication"
      X="230"
      Y="190"
      Width="360"
      Height="25"
      FontId="0"
      TabStop="yes"
      HideWhenDisabled="yes">
      &amp;Launch ThorCash Financial System
    </Checkbox>

    <!-- View release notes -->
    <Checkbox
      Name="ViewReleaseNotes"
      X="230"
      Y="220"
      Width="360"
      Height="25"
      FontId="0"
      TabStop="yes"
      HideWhenDisabled="yes">
      View &amp;Release Notes
    </Checkbox>

    <!-- Installation path info -->
    <Text X="230" Y="260" Width="360" Height="40" FontId="8" DisablePrefix="yes">
      Installed to: C:\Program Files\ThorCash\
      User data: %APPDATA%\ThorCash\
    </Text>

    <!-- Support info -->
    <Text X="230" Y="305" Width="360" Height="30" FontId="8" DisablePrefix="yes">
      Thor Technologies
      thorcash.com
    </Text>

    <!-- Buttons -->
    <Button
      Name="FinishButton"
      X="430"
      Y="420"
      Width="160"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="0A6633"
      HexForeground="FFFFFF"
      HexBorder="0A6633"
      HexHighlightBackground="0D803F"
      HexHighlightForeground="FFFFFF"
      HexHighlightBorder="0D803F">
      Finish
    </Button>
  </Page>

  <!-- Page: Resume / splash-like transition (dimmed overlay) -->
  <Page Name="Resume">
    <Rectangle X="0" Y="0" Width="620" Height="480" Fill="FFFFFF" />
    <Rectangle X="0" Y="0" Width="200" Height="480" Fill="0D1B2A" />
    <Text X="20" Y="100" Width="160" Height="60" FontId="4" DisablePrefix="yes">ThorCash</Text>
    <Text X="20" Y="155" Width="160" Height="40" FontId="5" DisablePrefix="yes">Financial System</Text>
    <Rectangle X="20" Y="195" Width="60" Height="3" Fill="0A6633" />
    <Text X="230" Y="180" Width="360" Height="30" FontId="2" DisablePrefix="yes">Resuming installation...</Text>
    <Button
      Name="CancelButton"
      X="430"
      Y="420"
      Width="160"
      Height="35"
      FontId="0"
      TabStop="yes"
      HexBackground="FFFFFF"
      HexForeground="1A1A1A"
      HexBorder="CCCCCC"
      HexHighlightBackground="F8D7DA"
      HexHighlightForeground="721C24"
      HexHighlightBorder="F5C6CB">
      Cancel
    </Button>
  </Page>
</Theme>
