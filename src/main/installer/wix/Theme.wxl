  <String Id="HelpHeader">Setup Help</String>
  <String Id="HelpText">
    /install | /repair | /uninstall | /layout [directory] - installs, repairs,
    uninstalls or creates a complete local copy of the bundle in the given directory.
    /install [directory] - installs to the given directory.
    /quiet - displays no UI while installing.
    /passive - displays only the progress UI while installing.
    /norestart - suppresses any reboot attempts.
    /log [file] - logs installation to a specific file.
  </String>
  <String Id="HelpCloseButton">Close</String>
